# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection (Neon pooled endpoint is fine here)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection — REQUIRED for Prisma migrations/shadow DB
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="generate-with: openssl rand -hex 48"
JWT_EXPIRES_IN="7d"

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_NAME=""
CLOUDINARY_KEY=""
CLOUDINARY_SECRET=""

# ── SendGrid (transactional email) ──────────────────────────────────────────
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="onboarding@resend.dev"
SENDGRID_FROM_NAME="Your App"

# ── Seed admin (created idempotently by prisma/seed.ts) ─────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="min-8-chars"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of frontend origins (no trailing slashes).
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
