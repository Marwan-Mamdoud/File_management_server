    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
